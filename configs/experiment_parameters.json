{
  "sample_rate": 16000,
  "n_clean_clips": 10,
  "clip_seconds_by_dataset": {
    "speech": 8.0,
    "instrumental_music": 8.0
  },
  "noise_ratios": {
    "gaussian": 0.2,
    "distant_speech": 0.4,
    "subway": 0.6
  },
  "active_noise_types": [
    "gaussian",
    "distant_speech",
    "subway"
  ],
  "datasets": [
    "piano_notes_chords",
    "speech",
    "instrumental_music"
  ],
  "methods": {
    "fft_threshold": {
      "parameter_presets": {
        "speech": {
          "keep_ratio": 1.0,
          "window_size": 1024,
          "hop_size": 256,
          "f_min": 50,
          "f_max": 8000
        },
        "instrumental_music": {
          "keep_ratio": 1.0,
          "window_size": 1024,
          "hop_size": 256,
          "f_min": 50,
          "f_max": 4000
        },
        "piano_notes_chords": {
          "keep_ratio": 1.0,
          "window_size": 2048,
          "hop_size": 512,
          "f_min": 50,
          "f_max": 4000
        }
      }
    },
    "l1_norm": {
      "parameter_presets": {
        "speech": {
          "grid_type": "linear",
          "n_freqs": 200,
          "f_min": 50,
          "f_max": 8000,
          "lambda_reg": 0.04,
          "max_iter": 80,
          "tol": 0.0001,
          "window_size": 512,
          "hop_size": 256
        },
        "instrumental_music": {
          "grid_type": "linear",
          "n_freqs": 200,
          "f_min": 50,
          "f_max": 5000,
          "lambda_reg": 0.04,
          "max_iter": 80,
          "tol": 0.0001,
          "window_size": 512,
          "hop_size": 256
        },
        "piano_notes_chords": {
          "grid_type": "linear",
          "n_freqs": 200,
          "f_min": 50,
          "f_max": 5000,
          "lambda_reg": 0.08,
          "max_iter": 80,
          "tol": 0.0001,
          "window_size": 512,
          "hop_size": 256
        }
      }
    },
    "least_squares": {
      "parameter_presets": {
        "speech": {
          "grid_type": "linear",
          "n_freqs": 500,
          "f_min": 50,
          "f_max": 7000,
          "K": 500,
          "window_size": 1024,
          "hop_size": 256
        },
        "instrumental_music": {
          "grid_type": "linear",
          "n_freqs": 500,
          "f_min": 50,
          "f_max": 4000,
          "K": 100,
          "window_size": 2048,
          "hop_size": 512
        },
        "piano_notes_chords": {
          "grid_type": "linear",
          "n_freqs": 500,
          "f_min": 50,
          "f_max": 4000,
          "K": 25,
          "window_size": 2048,
          "hop_size": 512
        }
      },
      "parameter_sweep": {
        "K_values": [
          40,
          80,
          120,
          250,
          350
        ],
        "n_freqs": 500,
        "window_size": 2048,
        "hop_size": 512,
        "clean_clip_limit": 5
      }
    },
    "omp": {
      "parameter_presets": {
        "speech": {
          "grid_type": "linear",
          "n_freqs": 400,
          "f_min": 50,
          "f_max": 7000,
          "K": 20,
          "tol": 0.01,
          "window_size": 1024,
          "hop_size": 256
        },
        "instrumental_music": {
          "grid_type": "linear",
          "n_freqs": 600,
          "f_min": 50,
          "f_max": 5000,
          "K": 40,
          "tol": 0.01,
          "window_size": 2048,
          "hop_size": 512
        },
        "piano_notes_chords": {
          "grid_type": "linear",
          "n_freqs": 600,
          "f_min": 50,
          "f_max": 5000,
          "K": 20,
          "tol": 0.01,
          "window_size": 2048,
          "hop_size": 512
        }
      }
    }
  }
}
